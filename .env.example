# GoTube 环境变量配置模板
# 复制为 .env 并修改相应值

# 服务端口
GOTUBE_PORT=8000

# 下载主页隐藏路径
GOTUBE_HIDDEN_PATH=7777

# 最大并发下载数
GOTUBE_MAX_CONCURRENT=5

# 下载目录
GOTUBE_DOWNLOAD_DIR=./downloads

# 是否允许匿名用户下载（默认开启）
# 匿名用户下载的文件存储到临时目录，关闭页面后自动删除
GOTUBE_ALLOW_GUEST_DOWNLOAD=1

# Cookies 文件路径
GOTUBE_COOKIES_FILE=./cookies.txt

GOTUBE_WWW_DIR=www_dist


# 管理页面认证账号（支持多管理员，格式：用户名1:密码1,用户名2:密码2）
GOTUBE_ADMINS=admin:changeme

# 调试模式（开启后启用 /docs 等开发者工具）
GOTUBE_DEBUG=0

# 日志级别（ERROR/WARNING/INFO/DEBUG，生产环境建议用 ERROR）
GOTUBE_LOG_LEVEL=ERROR

# 是否允许播放列表/用户空间URL下载（0=禁止，1=允许）
# 禁止后仅支持单个视频链接下载
GOTUBE_ALLOW_PLAYLIST_DOWNLOAD=0

# 单个视频最大文件大小限制（单位：MB，0=不限制）
# 超过此大小的视频将被拒绝下载
GOTUBE_MAX_VIDEO_SIZE_MB=0

# 普通用户默认视频库容量限制（MB），0=不限制；管理员不受此限制
GOTUBE_USER_STORAGE_QUOTA_MB=0
