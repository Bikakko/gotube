# GoTube 环境变量配置模板
# 复制为 .env 并修改相应值

# 服务端口
GOTUBE_PORT=8000

# 下载主页隐藏路径
GOTUBE_HIDDEN_PATH=7777

# 最大并发下载数
GOTUBE_MAX_CONCURRENT=5

# 下载目录
GOTUBE_DOWNLOAD_DIR=./downloads

# Cookies 文件路径
GOTUBE_COOKIES_FILE=./cookies.txt

# Basic Auth 用户名
GOTUBE_AUTH_USER=7777

# Basic Auth 密码
GOTUBE_AUTH_PASS=7777

# 管理页面认证用户名
GOTUBE_ADMIN_USER=admin

# 管理页面认证密码
GOTUBE_ADMIN_PASS=changeme

# 调试模式（开启后启用 /docs 等开发者工具）
GOTUBE_DEBUG=0
